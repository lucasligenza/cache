VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key      # web-push reminders
VITE_ANTHROPIC_API_KEY=your-anthropic-key        # reserved for AI sort (deferred, not wired)

# Optional error telemetry. Leave both blank to disable (the reporter is inert).
# VITE_SENTRY_DSN: Sentry project DSN (Project Settings → Client Keys).
# VITE_ERROR_REPORT_URL: your own collector; reports are POSTed as JSON (text/plain body).
VITE_SENTRY_DSN=
VITE_ERROR_REPORT_URL=
VITE_RELEASE=                                    # optional; defaults to VERCEL_GIT_COMMIT_SHA on Vercel
